        "backupType": { "type": "string", "enum": ["manual", "scheduled", "pre_restore"] },
        "checksum": { "type": "string", "minLength": 8, "maxLength": 128 },
        "sizeBytes": { "type": "integer" },
        "storagePath": { "type": "string", "maxLength": 320 },
        "restoredFromBackupId": { "type": "string", "maxLength": 128 },
        "recordSummary": { "type": "object" },
        "status": { "type": "string", "enum": ["completed", "verified"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "churchId", "ownerUid", "createdBy", "scope", "checksum", "status", "createdAt"]
    },
    "OwnershipTransfer": {
      "title": "OwnershipTransfer",
      "description": "Controlled multi-step Church Owner transfer request finalized strictly by Cloud Functions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "churchId": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fromUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fromEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "toUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "toEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "status": { "type": "string", "enum": ["pending", "accepted", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "churchId", "ownerUid", "fromUid", "fromEmail", "toUid", "toEmail", "status", "createdAt", "updatedAt", "expiresAt"]
    },
    "PlatformAdmin": {
      "title": "PlatformAdmin",
      "description": "Platform technical administrator registry without access to tenant congregation or financial data.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "status", "createdAt"]
    }
  },
